{
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"functions": {
		"api/index.js": {
			"maxDuration": 60
		}
	},
	"routes": [
		{
			"src": "^/(\\.git|\\.env|.*\\.db|.*\\.zip|.*\\.map|server-status|server-info)(/.*)?$",
			"status": 404
		},
		{
			"src": "^/api/(.*)$",
			"dest": "/api"
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/(.*)$",
			"dest": "/index.html"
		}
	]
}
