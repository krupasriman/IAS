{
	"name": "ias",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"server:dev": "tsx watch --clear-screen=false server/index.ts",
		"build": "tsc -b && vite build && esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
		"build:client": "tsc -b && vite build",
		"build:server": "esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
		"start": "node dist-server/index.js",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:security": "playwright test tests/security",
		"test:e2e": "playwright test tests/e2e",
		"test:e2e:headed": "playwright test tests/e2e --headed",
		"preview": "vite preview"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.27",
		"@hookform/resolvers": "^5.7.1",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.13",
		"ai": "^7.0.58",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"helmet": "^8.3.0",
		"idb": "^8.0.3",
		"lucide-react": "^1.28.0",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"prom-client": "^15.1.3",
		"rate-limit-redis": "^6.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.85.0",
		"react-router-dom": "^7.18.2",
		"redis": "^6.2.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/supertest": "^7.2.1",
		"@vitejs/plugin-react": "^6.0.4",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.1",
		"supertest": "^7.2.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.7",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
	}
}
