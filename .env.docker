# ==============================================================================
# Docker Compose Environment Configuration
# ==============================================================================
# Application Server Port
PORT=3001

# Runtime Environment (production / development)
NODE_ENV=production

# Authentication Mode: "local" (single-user dev/offline) or "session" (multi-tenant)
AUTH_MODE=local

# PostgreSQL Connection String (uses Docker service name "postgres")
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/ias

# Redis Cache / Rate Limiting (uses Docker service name "redis")
REDIS_URL=redis://redis:6379

# AES-256-GCM 32-byte Base64 Encryption Key for Secure Key Vault Storage
ENCRYPTION_KEY=dGhpc2lzYXRlc3RrZXlmaXJzdGhhc2gzMmJ5dGVzbG9uZw==

# Structured Logger Minimum Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
