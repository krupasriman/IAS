# ============================================
# IAS Study Notes Generator - Environment Config
# Copy this file to .env and update values as needed
# ============================================

# Frontend (Vite) Configuration
VITE_PORT=5173
VITE_API_TARGET=http://localhost:3001

# Backend (Express) Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (Turso Cloud SQLite)
# Leave unset for local development (defaults to local SQLite file: data/ias.db).
# Set these when deploying to Vercel or connecting to Turso Cloud:
# TURSO_DATABASE_URL=libsql://ias-db-yourusername.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Auth mode: "local" (no login needed, single-user) or "session" (password login)
AUTH_MODE=local

# API key encryption (server-side storage). Must be 32 bytes base64 (44 chars).
# If unset in development, a key is auto-generated and stored in data/.encryption.key
# ENCRYPTION_KEY=

# Rate limiting: Redis connection string (e.g. redis://localhost:6379).
# When set, the API rate limiter uses a Redis store (shared across instances);
# otherwise it falls back to an in-memory store.
# REDIS_URL=redis://localhost:6379

# Security (optional - for production)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com